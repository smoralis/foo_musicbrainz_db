#include <windows.h>
#include "resource.h"

// Child dialog hosted by Preferences > Tools > MusicBrainz DB.
// Sizes are in dialog units, so the page scales with DPI and the UI font.
IDD_MBDB_PREFS DIALOGEX 0, 0, 270, 300
STYLE DS_SETFONT | WS_CHILD
FONT 8, "MS Shell Dlg", 0, 0, 0x0
BEGIN
    GROUPBOX        "Logging", IDC_STATIC, 4, 4, 256, 30
    CONTROL         "Enable debug logging to the console (View > Console)", IDC_DEBUG_LOG,
                    "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 12, 16, 240, 12

    GROUPBOX        "Custom track fields", IDC_STATIC, 4, 40, 256, 100
    LTEXT           "Titleformatting patterns used instead of the plain artist and title tags",
                    IDC_STATIC, 12, 51, 240, 18
    LTEXT           "&Artist field:", IDC_STATIC, 12, 72, 56, 8
    EDITTEXT        IDC_ARTIST_FIELD, 72, 70, 180, 13, ES_AUTOHSCROLL
    LTEXT           "&Title field:", IDC_STATIC, 12, 88, 56, 8
    EDITTEXT        IDC_TITLE_FIELD, 72, 86, 180, 13, ES_AUTOHSCROLL
    LTEXT           "Examples: %album artist%   $if2(%artist%,%album artist%)   %title%",
                    IDC_STATIC, 12, 103, 240, 12
    LTEXT           "", IDC_FIELDS_STATUS, 12, 116, 240, 10

       GROUPBOX        "Stream metadata (dynamic info)", IDC_STATIC, 4, 144, 256, 32
    LTEXT           "&Delay search by:", IDC_STATIC, 12, 158, 64, 8
    EDITTEXT        IDC_DYNAMIC_DELAY, 78, 156, 30, 13, ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "seconds (0 = search immediately)", IDC_STATIC, 114, 158, 138, 8

    GROUPBOX        "MusicBrainz requests", IDC_STATIC, 4, 180, 256, 32
    LTEXT           "&Rate limit: wait", IDC_STATIC, 12, 194, 64, 8
    EDITTEXT        IDC_RATE_LIMIT, 78, 192, 30, 13, ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "seconds between requests (minimum 1)", IDC_STATIC, 114, 194, 138, 8

    GROUPBOX        "ListenBrainz Similar Artists", IDC_STATIC, 4, 216, 256, 62
    LTEXT           "Algorithm:", IDC_STATIC, 12, 228, 44, 8
    COMBOBOX        IDC_LB_ALGORITHM, 58, 226, 194, 100, CBS_DROPDOWN | CBS_AUTOHSCROLL | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "Load choices", IDC_LB_LOAD_ALGORITHMS, 58, 243, 70, 14
    LTEXT           "", IDC_LB_ALGORITHM_STATUS, 12, 260, 240, 12
END

// Modeless window opened by double-clicking an artist in the panel's artists tab.
IDD_MBDB_ARTIST_INFO DIALOGEX 0, 0, 300, 220
STYLE DS_SETFONT | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME | WS_MINIMIZEBOX
EXSTYLE WS_EX_TOOLWINDOW
CAPTION "Artist info"
FONT 9, "Segoe UI", 0, 0, 0x0
BEGIN
    CONTROL "", IDC_INFO_TEXT, "RICHEDIT50W",
            ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL |
            WS_VSCROLL | WS_TABSTOP,
            6, 6, 288, 190

    PUSHBUTTON      "Show Raw JSON", IDC_RAW_JSON, 164, 202, 74, 14
    DEFPUSHBUTTON   "Close", IDCANCEL, 244, 202, 50, 14
END
