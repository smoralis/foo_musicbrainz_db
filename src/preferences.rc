#include <windows.h>
#include "resource.h"

// Child dialog hosted by Preferences > Tools > MusicBrainz DB.
// Sizes are in dialog units, so the page scales with DPI and the UI font.
IDD_MBDB_PREFS DIALOGEX 0, 0, 270, 200
STYLE DS_SETFONT | WS_CHILD
FONT 8, "MS Shell Dlg", 0, 0, 0x0
BEGIN
    GROUPBOX        "Logging", IDC_STATIC, 4, 4, 256, 30
    CONTROL         "Enable debug logging to the console (View > Console)", IDC_DEBUG_LOG,
                    "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 12, 16, 240, 12

    GROUPBOX        "Custom track fields", IDC_STATIC, 4, 40, 256, 120
    LTEXT           "Titleformatting patterns used instead of the plain artist and title tags ",
                    IDC_STATIC, 12, 52, 240, 34
    LTEXT           "&Artist field:", IDC_STATIC, 12, 90, 56, 8
    EDITTEXT        IDC_ARTIST_FIELD, 72, 88, 180, 13, ES_AUTOHSCROLL
    LTEXT           "&Title field:", IDC_STATIC, 12, 108, 56, 8
    EDITTEXT        IDC_TITLE_FIELD, 72, 106, 180, 13, ES_AUTOHSCROLL
    LTEXT           "Example: $if(%inverted%,%title%,%artist%)",
                    IDC_STATIC, 12, 124, 240, 18
    LTEXT           "", IDC_FIELDS_STATUS, 12, 146, 240, 10

    GROUPBOX        "Stream metadata (dynamic info)", IDC_STATIC, 4, 164, 256, 32
    LTEXT           "&Delay search by:", IDC_STATIC, 12, 178, 64, 8
    EDITTEXT        IDC_DYNAMIC_DELAY, 78, 176, 30, 13, ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "seconds (0 = search immediately)", IDC_STATIC, 114, 178, 138, 8
END
